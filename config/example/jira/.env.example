# Jira + Confluence credentials.
JIRA_URL=https://your-org.atlassian.net
JIRA_EMAIL=you@example.com
JIRA_TOKEN=replace-me

JIRA_WRITE_ENABLED=true   # нужно true для постинга тест-кейсов в Jira комментарием
CONFLUENCE_WRITE_ENABLED=false

# Optional Confluence default page id (used by /jira-overview etc.).
# CONFLUENCE_PAGE_ID=

# Multi-account (Phase 7):
# JIRA__DEFAULT__URL=https://your-org.atlassian.net
# JIRA__DEFAULT__EMAIL=you@example.com
# JIRA__DEFAULT__TOKEN=...
