# Grafana credentials (read-only — service account token, Viewer role is enough).
GRAFANA_URL=https://grafana.example.com
GRAFANA_TOKEN=replace-me

# Optional: pin the VictoriaLogs datasource UID explicitly.
# Auto-detected by datasource type (victoriametrics-logs-datasource) when unset.
# GRAFANA_LOGS_DATASOURCE_UID=
