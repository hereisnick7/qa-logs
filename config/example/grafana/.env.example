# Grafana credentials (read-only — service account token, Viewer role is enough).
GRAFANA_URL=https://grafana.example.com
GRAFANA_TOKEN=replace-me

# Optional: pin the VictoriaLogs datasource UID explicitly.
# Auto-detected by datasource type (victoriametrics-logs-datasource) when unset.
# GRAFANA_LOGS_DATASOURCE_UID=

# Extra environments = extra accounts, selected with `--account=<name>`.
# Bare keys above are the `default` account; each named account needs its OWN
# URL + token (a named account never falls back to the bare ones, so a
# half-configured account fails loudly instead of pairing one instance's URL
# with another's token).
# GRAFANA__PROD__URL=https://grafana-prod.example.com
# GRAFANA__PROD__TOKEN=replace-me
